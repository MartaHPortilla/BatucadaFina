<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    tools:context=".ui.activities.UserHomeActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarUserHome"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Inicio"
        app:titleTextColor="@color/md_theme_onSecondary"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <TextView
        android:id="@+id/textViewWelcome"
        style="@style/TextAppearance.BatukAfina.HeadLineLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="200dp"
        android:text="Bienvenido, "
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarUserHome" />

    <TextView
        android:id="@+id/textViewUserName"
        style="@style/TextAppearance.BatukAfina.HeadLineLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="200dp"
        android:text="Usuario"
        android:textColor="@color/md_theme_primary"
        android:textSize="48sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/textViewWelcome"
        app:layout_constraintTop_toBottomOf="@+id/textViewWelcome" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imageViewProfilePicUserHome"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarUserHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textViewUserName"
        app:layout_constraintBottom_toBottomOf="@+id/textViewUserName"
        android:scaleType="fitEnd"
        android:layout_marginBottom="12dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MyApp.CircleImageView"
        app:srcCompat="@drawable/ic_default_user_avatar" />

    <LinearLayout
        android:id="@+id/linearLayoutTopButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewUserName">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonTips"
            style="@style/TopButtonStyle"
            android:drawableEnd="@drawable/ic_tips_icons8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:hapticFeedbackEnabled="false"
            android:text="TIPS" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSettings"
            style="@style/TopButtonStyle"
            android:drawableEnd="@drawable/ic_settings_icons8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="AJUSTES" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayoutMainButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutTopButtons">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBasicTuner"
            style="@style/OutlinedWhiteButtonStyle"
            android:textSize="18dp"
            android:drawableEnd="@drawable/ic_microphone_icons"
            android:backgroundTint="@color/md_theme_primary"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_margin="12dp"
            android:text="AFINADOR BÁSICO" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonTuneFavorites"
            style="@style/RegularButtonStyle"
            android:drawableEnd="@drawable/ic_star_favorite"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_margin="8dp"
            android:text="AFINA TUS FAVORITOS" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonInstruments"
            style="@style/RegularButtonStyle"
            android:drawableEnd="@drawable/ic_drum_icons8"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_margin="8dp"
            android:text="TODOS LOS INSTRUMENTOS" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCreateInstrument"
            style="@style/RegularButtonStyle"
            android:drawableEnd="@drawable/ic_add_drum_icons8"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_margin="8dp"
            android:text="CREAR NUEVO INSTRUMENTO" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>