<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/md_theme_surface"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ui.activities.SettingsActivity">

    <ImageView
        android:id="@+id/dialogIconChangeUsername"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        app:srcCompat="@drawable/ic_settings_icons8"/>

    <TextView
        android:id="@+id/dialogTitleChangeUsername"
        style="?attr/textAppearanceHeadlineSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal"
        tools:textColor="@color/md_theme_onSurface"
        android:text="Cambiar nombre de usuario"
        android:textColor="?attr/colorOnSurface" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/dialogTextInputLayoutNewUsername"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Nuevo nombre de usuario"
        android:textColorHint="@color/text_input_layout_hint_app"
        app:boxBackgroundColor="@color/text_input_layout_background_app">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialogEditTextNewUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:textColor="@color/md_theme_onPrimary" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDialogCancelUsername"
            style="@style/Widget.Material3.Button.TextButton.Dialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textColor="@color/md_theme_onBackground" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDialogUpdateUsername"
            style="@style/Widget.Material3.Button.TextButton.Dialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Actualizar"
            android:textColor="@color/batuk_accent_magenta"/>
    </LinearLayout>

</LinearLayout>