<?xml version="1.0" encoding="utf-8"?>
<resources>



    <style name="TopButtonStyle" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/button_text_color_on_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="backgroundTint">@color/button_background_top_app</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MyApp.TopButton</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="GradientButtonStyle" parent="Widget.Material3.Button">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_margin">8dp</item>
    <item name="android:textColor">@color/text_color_accent_app</item>
    <item name="background">@color/cardview_dark_background</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textStyle">normal</item>
    <item name="android:padding">12dp</item>
    <item name="shapeAppearance">@style/ShapeAppearance.MyApp.Button</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    </style>

    <style name="MagentaButtonStyle" parent="Widget.Material3.Button"> <!-- Estilo personalizado para el botón principal, actualizado -->
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:textColor">@color/batuk_on_dark_primary_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:padding">12dp</item>
        <item name="backgroundTint">@color/batuk_accent_magenta</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MyApp.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="OutlinedMagentaButtonStyle" parent="Widget.Material3.Button.OutlinedButton"> <!-- Estilo personalizado para el botón con borde -->
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:textColor">@color/batuk_accent_magenta</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:padding">12dp</item>
        <item name="backgroundTint">@color/md_theme_background</item>
        <item name="strokeColor">@color/batuk_accent_magenta</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MyApp.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="OutlinedWhiteButtonStyle" parent="Widget.Material3.Button.OutlinedButton"> <!-- Estilo personalizado para el botón con borde -->
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:textColor">@color/md_theme_outline</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:padding">12dp</item>
        <item name="backgroundTint">@color/md_theme_background</item>
        <item name="strokeColor">@color/md_theme_outline</item>
