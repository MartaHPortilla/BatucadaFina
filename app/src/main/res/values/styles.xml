        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="RegularButtonStyle" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:textColor">@color/md_theme_onPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:padding">12dp</item>
        <item name="backgroundTint">@color/button_background_regular_app</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MyApp.Button</item>
        <item name="android:textAllCaps">false</item>
