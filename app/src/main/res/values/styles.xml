    <style name="TextAppearance.BatukAfina.HeadLineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_color_primary_app</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.BatukAfina.BodyMedium16" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_color_primary_app</item>
    </style>

    <style name="TextAppearance.BatukAfina.BodyMedium14" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_color_secondary_app</item>
    </style>

    <style name="ShapeAppearance.MyApp.CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.MyApp.Button" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.MyApp.TopButton" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

</resources>